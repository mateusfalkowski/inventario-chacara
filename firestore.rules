rules_version = '2';

// Sem senha: o app entra sozinho com login anônimo do Firebase (Authentication →
// Método de login → Anônimo precisa estar ativado). Basta estar logado para ler e
// gravar; quem não abre o app não acessa o banco. Ninguém apaga itens nem fotos.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }

    match /itens/{id} {
      allow read: if logado();
      allow create, update: if logado()
        && request.resource.data.quantidade >= 0;
      allow delete: if false;
    }
    match /fotos/{id} {
      allow read, create: if logado();
      allow update, delete: if false;
    }
  }
}
