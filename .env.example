# Copie para .env.local e preencha com os dados do app web do Firebase
# (Console → Configurações do projeto → Seus apps → Configuração do SDK).
# Sem estas variáveis, o app roda em "modo demonstração" (dados só no aparelho).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# E-mail da conta única da equipe (Authentication → Usuários). Quem usa o app só digita a senha.
VITE_EQUIPE_EMAIL=
